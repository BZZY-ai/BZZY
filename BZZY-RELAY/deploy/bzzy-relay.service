[Unit]
Description=BZZY encrypted device relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bzzy-relay
Group=bzzy-relay
WorkingDirectory=/opt/bzzy-relay
ExecStart=/usr/local/bin/node /opt/bzzy-relay/bin/relay.js serve --state /var/lib/bzzy-relay --audience wss://relay.example.invalid/v1/socket --port 8787
StateDirectory=bzzy-relay
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
IPAddressDeny=any
IPAddressAllow=localhost
# APNs uses DNS load balancing. Permit Apple's published IPv4/IPv6 networks,
# not one resolved address. The application still listens only on loopback.
# See https://support.apple.com/en-us/101555 and deploy/README.md for DNS setup.
IPAddressAllow=17.0.0.0/8
IPAddressAllow=2403:300::/32
IPAddressAllow=2620:149::/32
IPAddressAllow=2a01:b740::/32
MemoryMax=512M
CPUQuota=100%
TasksMax=64
LimitNOFILE=1024
LimitCORE=0
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=multi-user.target
